{% extends 'base.html.twig' %}

{% block title %}Liste des sports{% endblock %}

{% block body %}
    <h1>Liste des sports</h1>

    <table class="table" border="1">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
            </tr>
        </thead>
        <tbody>
        {% for sport in sports %}
            <tr>
                <td>{{ sport.id }}</td>
                <td>{{ sport.nom }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="2">Aucun sport trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
